{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Linardi1328/personal-project-operator/blob/main/capabilities/customer-zero-project.schema.json",
  "title": "Customer Zero project capability manifest",
  "description": "Declarative, non-authoritative metadata for one fixed Customer Zero repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "repository",
    "runtimePreparation",
    "localQualityGates",
    "github",
    "deploymentProvider"
  ],
  "properties": {
    "$schema": { "const": "./customer-zero-project.schema.json" },
    "schemaVersion": { "const": "customer-zero-project-capability.v1" },
    "manifestVersion": { "type": "integer", "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "fullName", "defaultBranch"],
      "properties": {
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "fullName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "runtimePreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "mode", "profileId", "ownerManaged", "callerOverridesAllowed"],
      "properties": {
        "platform": { "enum": ["darwin", "linux"] },
        "mode": { "enum": ["preconfigured", "script"] },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "script": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "ownerManaged": { "type": "boolean" },
        "callerOverridesAllowed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "script" } } },
          "then": { "required": ["script"] },
          "else": { "not": { "required": ["script"] } }
        }
      ]
    },
    "localQualityGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "timeoutMs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "job", "requiredSteps"],
      "properties": {
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" },
        "job": { "type": "string", "minLength": 1, "maxLength": 100 },
        "requiredSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "deploymentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "profileId", "authority", "exactShaRequired", "manifestCanDeploy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authority": { "enum": ["owner", "reviewed-agent"] },
        "exactShaRequired": { "type": "boolean" },
        "manifestCanDeploy": { "type": "boolean" }
      }
    }
  }
}
