      "policyId": "phase-6e-spy-market-agent-fixed-python-pytest-policy",
      "policyVersion": "1",
      "gates": [
        {
          "id": "pytest",
          "command": [
            "python3.12",
            "-m",
            "pytest",
            "tests"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        }
      ],
