      "policyVersion": "1",
      "gates": [
        {
          "id": "pytest",
          "command": [
            "python3.12",
            "-m",
            "pytest",
            "tests"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        }
      ],
      "githubWorkflow": "unverified",
      "deploymentProvider": "unverified",
      "manifestCanExecute": false,
      "manifestCanDeploy": false
    },
    {
      "projectId": "spy-market-agent",
