      "runtimeProfileId": "phase-6k-fixed-local-runtime-profile",
      "policyId": "phase-6e-portfolio-fixed-next-quality-policy",
      "policyVersion": "1",
      "gates": [
        {
          "id": "typecheck",
          "command": [
            "node",
            "approved:portfolioTypecheck",
            "--noEmit"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        },
        {
          "id": "eslint",
          "command": [
            "node",
            "approved:portfolioEslint",
            "."
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        }
      ],
      "githubWorkflow": "unverified",
      "deploymentProvider": "unverified",
