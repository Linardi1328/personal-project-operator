{
  "schemaVersion": "customer-zero-ordinary-policy-catalog.v1",
  "projects": [
    {
      "projectId": "khlim-assist",
      "repository": "Linardi1328/khlim-assist",
      "runtimeProfileId": "phase-6k-fixed-local-runtime-profile",
      "policyId": "phase-6e-khlim-assist-fixed-python-quality-policy",
      "policyVersion": "1",
      "gates": [
        {
          "id": "ruff",
          "command": [
            "python3.12",
            "-m",
            "ruff",
            "check",
            "--no-cache",
            "."
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        },
        {
          "id": "mypy",
          "command": [
            "python3.12",
            "-m",
            "mypy",
            "--no-incremental",
            "backend/app"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        },
        {
          "id": "pytest",
          "command": [
            "python3.12",
            "-m",
            "pytest",
            "-p",
            "no:cacheprovider",
            "backend/tests"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        }
      ],
      "githubWorkflow": "unverified",
      "deploymentProvider": "unverified",
      "manifestCanExecute": false,
      "manifestCanDeploy": false
    },
    {
      "projectId": "ledgerpilot-ai",
      "repository": "Linardi1328/ledgerpilot-ai",
