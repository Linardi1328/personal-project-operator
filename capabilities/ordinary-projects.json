    {
      "projectId": "rbl-content-engine",
      "repository": "Linardi1328/rbl-content-engine",
      "runtimeProfileId": "phase-6k-fixed-local-runtime-profile",
      "policyId": "phase-6e-rbl-content-engine-fixed-python-unittest-policy",
      "policyVersion": "1",
      "gates": [
        {
          "id": "compile",
          "command": [
            "python3.12",
            "-m",
            "compileall",
            "-q",
            "src",
            "tests"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        },
        {
          "id": "unittest",
          "command": [
            "python3.12",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-p",
            "test_*.py",
            "-v"
          ],
          "timeoutMs": 120000,
          "required": true,
          "shell": false
        }
      ],
      "githubWorkflow": "unverified",
      "deploymentProvider": "unverified",
      "manifestCanExecute": false,
      "manifestCanDeploy": false
    },
