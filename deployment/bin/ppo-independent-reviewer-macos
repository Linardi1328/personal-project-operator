#!/usr/bin/env bash
set -Eeuo pipefail

CODEX_BIN="/Users/richie/.local/bin/codex"
CODEX_MODEL="gpt-5.6-sol"
REVIEW_OUTPUT_SCHEMA="/Users/richie/personal-project-operator/deployment/phase6f-review-output.schema.json"
WORKSPACE_ROOT="/Users/richie/.local/share/personal-project-operator/development-workspaces"

if [[ "${PPO_PHASE6K_REVIEW_POLICY:-}" != "fixed" ]]; then
  printf 'PPO independent reviewer refused an untrusted invocation.\n' >&2
  exit 78
fi

if [[ ! -x "$CODEX_BIN" ]]; then
  printf 'PPO independent reviewer runtime is unavailable.\n' >&2
  exit 78
fi

if [[ ! -r "$REVIEW_OUTPUT_SCHEMA" ]]; then
  printf 'PPO independent reviewer output schema is unavailable.\n' >&2
  exit 78
fi

case "$PWD" in
  "$WORKSPACE_ROOT"/*) ;;
  *)
    printf 'PPO independent reviewer refused a workspace outside the managed root.\n' >&2
    exit 78
    ;;
esac

export HOME="/Users/richie"
export CODEX_HOME="/Users/richie/.codex"
export PATH="/Users/richie/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"

exec "$CODEX_BIN" \
  --ask-for-approval never \
  exec \
  --ephemeral \
  --color never \
  --sandbox read-only \
  --ignore-user-config \
  --ignore-rules \
  --strict-config \
  --output-schema "$REVIEW_OUTPUT_SCHEMA" \
  --model "$CODEX_MODEL" \
  -
